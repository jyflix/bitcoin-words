# ─────────────────────────────────────────────────────────────────────────────
# Private RPC / API providers — all optional.
#
# Copy this file to .env.local and fill in what you have. Keys are read on the
# server only: a chain with a private provider is looked up through this app's
# /api routes, which add the key — the browser never sees it. Chains without
# one use the free public endpoints straight from the browser.
#
# Never prefix these with NEXT_PUBLIC_ (that would ship them to every visitor).
# Restart `npm run dev`, or rebuild, after changing them.
# URL templates and the full provider list live in src/config/providers.ts.
# ─────────────────────────────────────────────────────────────────────────────

# Alchemy app "API Key" (dashboard.alchemy.com). Used for Ethereum and Solana.
ALCHEMY_API_KEY=

# Infura API key. Ethereum.
INFURA_API_KEY=

# Helius API key. Solana.
HELIUS_API_KEY=

# Any other JSON-RPC endpoints — QuickNode, Chainstack, Ankr, your own node…
# Comma-separated full URLs (the key is usually part of the URL).
ETH_RPC_URLS=
SOL_RPC_URLS=

# Bitcoin balances need an address-index API (plain bitcoind RPC can't look them up).
# Esplora API base URLs, e.g. your own mempool / Esplora on Umbrel or Start9:
#   BTC_ESPLORA_URLS=http://umbrel.local:3006/api
BTC_ESPLORA_URLS=
# Blockbook API base URLs ending in /api/v2 (NOWNodes, GetBlock, your own Blockbook…)
BTC_BLOCKBOOK_URLS=
# Optional Blockbook key, sent as the "api-key" header (e.g. NOWNodes).
BTC_BLOCKBOOK_API_KEY=

# Fall back to the free public endpoints when every private provider fails.
PUBLIC_FALLBACK=true

# Requests per minute per IP accepted by the /api routes (0 = no limit).
API_RATE_LIMIT=600
