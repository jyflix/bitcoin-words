# Optional endpoint overrides — comma-separated, tried in order (Bitcoin is spread round-robin).
# Only public addresses are sent to them. Their origins are added to the Content-Security-Policy
# automatically; rebuild after changing. NEXT_PUBLIC_* values are visible in the browser, so use
# domain-restricted API keys.

# Esplora-compatible REST APIs
# NEXT_PUBLIC_BTC_API=https://mempool.space/api,https://blockstream.info/api

# Ethereum mainnet JSON-RPC
# NEXT_PUBLIC_ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/<your-key>,https://ethereum-rpc.publicnode.com

# Solana mainnet JSON-RPC
# NEXT_PUBLIC_SOL_RPC=https://mainnet.helius-rpc.com/?api-key=<your-key>,https://solana-rpc.publicnode.com
